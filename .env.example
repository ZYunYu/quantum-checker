# For deployment only. Do not commit real credentials.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
# Render supplies RENDER_EXTERNAL_HOSTNAME automatically.
# For another host:
# DJANGO_ALLOWED_HOSTS=your-domain.example
